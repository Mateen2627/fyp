{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^7.2||^8.0",
        "barryvdh/laravel-dompdf": "^2.0",
        "fakerphp/faker": "^1.14",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "hashids/hashids": "^4.1.0",
        "laravel/framework": "^8.40",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^3.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.8",
        "facade/ignition": "^2.5",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "audit": {
            "ignore": {
                "PKSA-cv56-2228-pzr6": "Required for Laravel 8 compatibility",
                "PKSA-6r8f-nxsb-67bq": "Required for Laravel 8 compatibility",
                "PKSA-gh7h-hhy4-byg7": "Required for Laravel 8 compatibility",
                "PKSA-mwt3-h9tv-kx78": "Required for Laravel 8 compatibility",
                "PKSA-hp6n-n4kz-21wk": "Required for Laravel 8 compatibility",
                "PKSA-mckv-s5hg-868k": "Required for Laravel 8 compatibility",
                "PKSA-7ztm-rpt3-qqzk": "Required for Laravel 8 compatibility",
                "PKSA-2kw5-jd8w-5mvh": "Required for Laravel 8 compatibility",
                "PKSA-4jrs-y99s-q8j6": "Required for Laravel 8 compatibility",
                "PKSA-hbk6-2vfz-8f8n": "Required for Laravel 8 compatibility"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ]
    }
}